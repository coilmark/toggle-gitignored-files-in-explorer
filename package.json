{
	"name": "toggle-gitignored-files-in-explorer",
	"displayName": "Toggle Gitignored Files in Explorer",
	"description": "Status bar toggle for VS Code's built-in gitignore Explorer filter",
	"icon": "images/icon128.png",
	"version": "0.2.0",
	"license": "MIT",
	"keywords": [
		"git",
		"gitignore",
		".gitignore",
		"toggle",
		"show",
		"hide",
		"file",
		"explorer",
		"status bar"
	],
	"galleryBanner": {
		"color": "#2F363D",
		"theme": "dark"
	},
	"publisher": "coilmark",
	"author": {
		"name": "coilmark"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/coilmark/toggle-gitignored-files-in-explorer.git"
	},
	"homepage": "https://github.com/coilmark/toggle-gitignored-files-in-explorer",
	"bugs": "https://github.com/coilmark/toggle-gitignored-files-in-explorer/issues",
	"engines": {
		"vscode": "^1.68.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "gitignoredFiles.hide",
				"title": "Hide Gitignored Files",
				"enablement": "!gitignoredFiles:isExcluded && gitignoredFiles:isGitignoreFound"
			},
			{
				"command": "gitignoredFiles.show",
				"title": "Show Gitignored Files",
				"enablement": "gitignoredFiles:isExcluded && gitignoredFiles:isGitignoreFound"
			}
		],
		"menus": {
			"explorer/context": [
				{
					"command": "gitignoredFiles.show",
					"group": "1_copypath@998",
					"when": "gitignoredFiles:isExcluded && gitignoredFiles:isGitignoreFound"
				},
				{
					"command": "gitignoredFiles.hide",
					"group": "1_copypath@997",
					"when": "!gitignoredFiles:isExcluded && gitignoredFiles:isGitignoreFound"
				}
			]
		}
	},
	"scripts": {
		"deploy": "npx @vscode/vsce publish",
		"lint": "eslint src --max-warnings=0",
		"fix:prettier": "prettier \"**/*.ts\" --write",
		"package": "npx @vscode/vsce package",
		"vscode:prepublish": "npm run lint && webpack --mode production",
		"watch": "webpack --watch --mode development",
		"webpack": "webpack --mode production",
		"webpack-dev": "webpack --mode development"
	},
	"devDependencies": {
		"@types/node": "24.x",
		"@types/vscode": "^1.68.0",
		"eslint": "^9.39.5",
		"prettier": "3.9.6",
		"ts-loader": "^9.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"webpack": "^5.108.4",
		"webpack-cli": "^7.2.1"
	}
}
